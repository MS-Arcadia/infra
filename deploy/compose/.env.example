# Arcadia local environment.
#
#   cp .env.example .env
#
# Development defaults, not secrets. Every credential here says change-me on purpose:
# a plausible-looking default is how a local value ends up somewhere reachable, and CI
# fails if one of these stops being an obvious placeholder.

# --- Ports (change only if something on your machine already uses one) -------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
WALLET_HTTP_PORT=8080
WALLET_GRPC_PORT=9090
PAYMENT_HTTP_PORT=8081
PAYMENT_GRPC_PORT=9091
CATALOG_HTTP_PORT=8082
ORDER_HTTP_PORT=8083
MEDIA_HTTP_PORT=8084
NOTIFICATION_HTTP_PORT=8086
MARKETPLACE_HTTP_PORT=8087
REVIEW_HTTP_PORT=8088
FESTIVAL_HTTP_PORT=8089
GATEWAY_PORT=8090
COMMUNITY_HTTP_PORT=8091
SEARCH_HTTP_PORT=8092
RECOMMENDATION_HTTP_PORT=8093
FRONTEND_PORT=3000
PROMETHEUS_PORT=9095
GRAFANA_PORT=3001

# --- Postgres superuser ------------------------------------------------------
# Per-service roles and databases are created by deploy/postgres/init, each isolated
# from the others by grants.
POSTGRES_USER=arcadia
POSTGRES_PASSWORD=local-development-change-me

# --- Secrets -----------------------------------------------------------------
# Signs and verifies access tokens. Every service verifies with the same value, so it
# must match whatever the Auth service is configured with. Minimum 32 bytes.
JWT_SECRET=local-development-jwt-secret-change-me-please

# --- Auth & Profile -----------------------------------------------------------
#
# The issuer and audience every service verifies. They are not decoration: a token without them is
# rejected by all five of the others.
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia
AUTH_HTTP_PORT=8085

# The initial administrator from requirement 1.1, seeded once on first boot. There is nobody to
# approve the first admin, so this account is created ACTIVE — change the password immediately.
# A resolvable-looking domain, not `.local`. RFC 6762 reserves `.local` for
# mDNS, and the auth service's email validator refuses it — which meant the
# seeded Super-Admin existed in the database and could never log in, so nobody
# could approve a registration, grant a role or publish a game.
SUPER_ADMIN_EMAIL=admin@arcadia.example
SUPER_ADMIN_PASSWORD=local-development-super-admin-change-me

# Auth rate limits. The production-shaped defaults inside the service are 5/minute for register and
# 10/minute for login; these are relaxed because the end-to-end suite creates accounts from one IP.
# Lower them to the service defaults to see the limiter work.
AUTH_RATE_LIMIT_REGISTER=200/minute
AUTH_RATE_LIMIT_LOGIN=200/minute

# The credential the wallet presents to the Payment Adapter. Leave empty and the wallet signs its
# own short-lived SERVICE token from JWT_SECRET — correct for a stack with no Auth service. Set it
# to inject a token issued elsewhere; the wallet then presents that instead of signing anything.
WALLET_SERVICE_TOKEN=

# The HMAC key for gift-card code hashing. Permanent secret state: rotating it makes
# every unredeemed gift card unredeemable, because the stored hashes can no longer be
# reproduced. Minimum 32 bytes.
GIFT_CARD_PEPPER=local-development-gift-card-pepper-change-me

# Authenticates bank callbacks. The sandbox gateway signs its own with it, so the
# signature-verification path is exercised locally. Minimum 16 bytes.
GATEWAY_CALLBACK_SECRET=local-development-callback-secret-change-me

# Signs the media service's download URLs. Must DIFFER from JWT_SECRET: a download token is
# not an identity token, and one leaking must not compromise the other. The service refuses
# to boot if they match. Minimum 32 bytes.
MEDIA_DOWNLOAD_SECRET=local-development-media-download-change-me

# How much the object store may hold in total, and how much any one developer may. Both are
# deliberately small for a laptop: the media volume shares the host disk with Postgres, so
# filling it takes the database down too. 5 GiB / 1 GiB.
MEDIA_STORAGE_SOFT_LIMIT_BYTES=5368709120
MEDIA_OWNER_QUOTA_BYTES=1073741824

# --- Object storage (MinIO) ---------------------------------------------------
#
# MinIO is pinned to an old release on purpose: the community console lost its management
# features in mid-2025, and this one still administers buckets, policies and users.
#
# The root credentials are the console login and can do anything. The services get
# MEDIA_S3_* instead — a separate user scoped to one bucket, created by minio-setup.sh — so a
# leaked service key cannot delete every bucket.
MINIO_ROOT_USER=arcadia-root
MINIO_ROOT_PASSWORD=local-development-minio-root-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MEDIA_S3_BUCKET=arcadia-media
MEDIA_S3_ACCESS_KEY=arcadia-media-service
MEDIA_S3_SECRET_KEY=local-development-media-s3-change-me

# Set to `filesystem` to run without MinIO — one fewer container and 512 MB back, at the cost
# of a service that cannot run more than one replica. The media-data volume is still there.
MEDIA_STORAGE_BACKEND=s3

# --- Domain ------------------------------------------------------------------
# ISO-4217 code. Every amount is an integer count of this currency's minor unit.
WALLET_CURRENCY=IRR

# The wallet that receives the platform's 30% of every sale. A real user id in Auth rather
# than a magic string, so the platform's balance lives in the same ledger as everybody
# else's and reconciliation covers it too.
#
# Must be a valid UUID: the wallet service stores user_id as `uuid`, so anything else is
# rejected — and it would be rejected on the platform credit, i.e. after the buyer had
# already been debited.
PLATFORM_USER_ID=00000000-0000-4000-8000-000000000001

# --- Gateway -----------------------------------------------------------------
# The one address a browser uses. The ten services stay on the internal network.

# Requirement 1.6 says the matching pass runs every 5 minutes. Shortened locally so a
# reviewer sees it happen; POST /v1/admin/matching/run runs one immediately either way.
MARKETPLACE_MATCH_INTERVAL=1m

# Where the storefront is served from. An allow-list rather than `*`: `*` plus a bearer
# token means any page on the internet can call this API with a token it has phished,
# and the browser will allow it. Comma-separated to add more.
GATEWAY_CORS_ORIGINS=http://localhost:3000

# Per-client-address budget. 600/min is ten requests a second — well above a browsing
# session and well below a scraper.
GATEWAY_RATE_LIMIT_PER_MINUTE=600

# How long one upstream request may take. Generous because media streams large files
# through the gateway.
GATEWAY_UPSTREAM_TIMEOUT=30s

LOG_LEVEL=info
GRAFANA_PASSWORD=local-development-change-me

# --- Recommendation: which space §3.1's content half ranks in ----------------
# `sparse` is cosine over Catalog's genres and tags — no external dependency, and it explains its own
# suggestions. `dense` is cosine over semantic embeddings: it finds neighbours nobody labelled the same way,
# but produces no reasons on its own, so pair it with an explanation backend. Both vectors are ingested
# either way, so switching is a restart, not a migration.
RECOMMENDATION_SCORING_BACKEND=sparse

# Where semantic vectors come from. `hashing` is a deterministic in-process fallback that needs no key and
# recovers only exact word overlap — enough to exercise the dense path, not enough to be good at it. The
# other value is `huggingface`, which POSTs to the feature-extraction endpoint below; it refuses to boot
# with no endpoint set rather than quietly leaving the whole catalogue unembedded.
RECOMMENDATION_EMBEDDING_BACKEND=hashing
# The full path including the pipeline, POSTed verbatim — e.g.
# https://router.huggingface.co/hf-inference/models/intfloat/multilingual-e5-large/pipeline/feature-extraction
RECOMMENDATION_EMBEDDING_ENDPOINT=
RECOMMENDATION_EMBEDDING_API_KEY=
# Must match the model's output width, and is baked into the `vector(n)` column: changing it later means a
# new migration and re-embedding every game. 1024 fits the e5 model above and BAAI/bge-m3;
# all-MiniLM-L6-v2 is 384.
RECOMMENDATION_EMBEDDING_DIMENSIONS=1024
# Prepended to every text before embedding, for models trained to expect it: the e5 family wants
# "query: " (quote it — the trailing space is part of the value) and separates a match from a non-match
# measurably worse without it. Leave empty for bge-m3 and all-MiniLM, which are degraded by a prefix.
# Changing it invalidates every stored vector, so re-embed the catalogue after.
RECOMMENDATION_EMBEDDING_PREFIX=

# Who writes the human-readable `reasons` on each suggestion, over any OpenAI-compatible
# /chat/completions endpoint. One call per user per five-minute sweep — never on the read path. Set to
# `openai` to turn it on; the base URL stops at /v1 and `/chat/completions` is appended, so
# https://api.llm7.io/v1 (free, no card), https://api.groq.com/openai/v1 and a local
# http://localhost:11434/v1 are all drop-in. The model must honour `response_format: json_object` or the
# sweep produces no reasons at all — the default below is the pair the service's own .env.example ships.
RECOMMENDATION_EXPLANATION_BACKEND=none
RECOMMENDATION_EXPLANATION_BASE_URL=
RECOMMENDATION_EXPLANATION_API_KEY=
RECOMMENDATION_EXPLANATION_MODEL=gemini-3.1-flash-lite

# --- Image tags (built by each service's `make docker`) ----------------------
WALLET_VERSION=local
PAYMENT_VERSION=local
CATALOG_VERSION=local
ORDER_VERSION=local
MEDIA_VERSION=local
AUTH_VERSION=local
NOTIFICATION_VERSION=local
MARKETPLACE_VERSION=local
REVIEW_VERSION=local
FESTIVAL_VERSION=local
COMMUNITY_VERSION=local
SEARCH_VERSION=local
RECOMMENDATION_VERSION=local
GATEWAY_VERSION=local
FRONTEND_VERSION=local
