# Arcadia local environment.
#
#   cp .env.example .env
#
# These are development defaults, not secrets. The two values that must be changed for
# anything reachable are JWT_SECRET and GIFT_CARD_PEPPER — see the notes below.

# --- Ports (change only if something on your machine already uses one) -------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
WALLET_HTTP_PORT=8080
WALLET_GRPC_PORT=9090
PAYMENT_HTTP_PORT=8081
PAYMENT_GRPC_PORT=9091
KAFKA_UI_PORT=8085
PROMETHEUS_PORT=9095
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200

# --- Postgres superuser ------------------------------------------------------
# Per-service roles and databases are created by deploy/postgres/init, each isolated
# from the others by grants.
POSTGRES_USER=arcadia
POSTGRES_PASSWORD=arcadia

# --- Secrets -----------------------------------------------------------------
# JWT_SECRET signs and verifies access tokens. Every service verifies with the same
# value, so it must match whatever the Auth service is configured with. Minimum 32 bytes.
JWT_SECRET=local-development-jwt-secret-change-me-please

# GIFT_CARD_PEPPER is the HMAC key for gift-card code hashing. Treat it as permanent
# secret state: rotating it makes every unredeemed gift card unredeemable, because the
# stored hashes can no longer be reproduced. Minimum 32 bytes.
GIFT_CARD_PEPPER=local-development-gift-card-pepper-change-me

# GATEWAY_CALLBACK_SECRET authenticates bank callbacks. The sandbox gateway signs its
# own callbacks with it so that the signature-verification path is exercised locally
# rather than first meeting production. Minimum 16 bytes.
GATEWAY_CALLBACK_SECRET=local-development-callback-secret

# --- Domain settings ---------------------------------------------------------
# ISO-4217 code. Every amount in the platform is an integer count of this currency's
# minor unit.
WALLET_CURRENCY=IRR

# --- Observability -----------------------------------------------------------
# Turn on after starting the observability profile:
#   docker compose --profile observability up -d
OTEL_ENABLED=false
LOG_LEVEL=info
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Image tags --------------------------------------------------------------
WALLET_VERSION=local
PAYMENT_VERSION=local
