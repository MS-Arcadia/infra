# Arcadia local environment.
#
#   cp .env.example .env
#
# Development defaults, not secrets. Every credential here says change-me on purpose:
# a plausible-looking default is how a local value ends up somewhere reachable, and CI
# fails if one of these stops being an obvious placeholder.

# --- Ports (change only if something on your machine already uses one) -------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
WALLET_HTTP_PORT=8080
WALLET_GRPC_PORT=9090
PAYMENT_HTTP_PORT=8081
PAYMENT_GRPC_PORT=9091
PROMETHEUS_PORT=9095
GRAFANA_PORT=3001

# --- Postgres superuser ------------------------------------------------------
# Per-service roles and databases are created by deploy/postgres/init, each isolated
# from the others by grants.
POSTGRES_USER=arcadia
POSTGRES_PASSWORD=local-development-change-me

# --- Secrets -----------------------------------------------------------------
# Signs and verifies access tokens. Every service verifies with the same value, so it
# must match whatever the Auth service is configured with. Minimum 32 bytes.
JWT_SECRET=local-development-jwt-secret-change-me-please

# The HMAC key for gift-card code hashing. Permanent secret state: rotating it makes
# every unredeemed gift card unredeemable, because the stored hashes can no longer be
# reproduced. Minimum 32 bytes.
GIFT_CARD_PEPPER=local-development-gift-card-pepper-change-me

# Authenticates bank callbacks. The sandbox gateway signs its own with it, so the
# signature-verification path is exercised locally. Minimum 16 bytes.
GATEWAY_CALLBACK_SECRET=local-development-callback-secret-change-me

# --- Domain ------------------------------------------------------------------
# ISO-4217 code. Every amount is an integer count of this currency's minor unit.
WALLET_CURRENCY=IRR

LOG_LEVEL=info
GRAFANA_PASSWORD=local-development-change-me

# --- Image tags (built by each service's `make docker`) ----------------------
WALLET_VERSION=local
PAYMENT_VERSION=local
