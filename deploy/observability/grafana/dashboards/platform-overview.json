{
  "uid": "arcadia-platform-overview",
  "title": "Arcadia — Platform Overview",
  "description": "Every service in one place: is it up, how much traffic is it taking, how much of that is failing, how slow are the slow ones, and how much CPU/memory each pod is actually using.",
  "tags": ["arcadia"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Services up",
      "description": "Out of every scrape target. Anything less than the total means a service stopped answering /metrics.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(up{job!=\"kubernetes-cadvisor\"})" },
        { "refId": "B", "expr": "count(up{job!=\"kubernetes-cadvisor\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "table",
      "title": "Service status",
      "description": "One row per scrape target. 0 means Prometheus could not reach that service's /metrics at all.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job!=\"kubernetes-cadvisor\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "instance": true, "__name__": true } } }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          },
          "custom": { "cellOptions": { "type": "color-background" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "RED method, rate. Every service and the gateway share this metric via the platform's common metrics package.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(arcadia_rpc_requests_total[5m]))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "Error rate by service",
      "description": "RED method, errors. Non-2xx/3xx responses as a share of that service's own traffic.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(arcadia_rpc_requests_total{code!~\"OK|2..|3..\"}[5m])) / sum by (service) (rate(arcadia_rpc_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by service",
      "description": "RED method, duration. The platform's own objective is 300ms.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(arcadia_rpc_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.3 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Per topic/group, across every consuming service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "arcadia_kafka_consumer_lag", "legendFormat": "{{service}} {{topic}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Pod CPU usage",
      "description": "From each node's cAdvisor, filtered to this namespace. Compare against the limits set in infra/deploy/k8s — a pod pinned at its ceiling is throttled, not crashed, so this is the only place that shows it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"arcadia\", container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "Pod memory usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"arcadia\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "Business rule rejections",
      "description": "A purchase, review or trade the domain layer refused — not an error, but worth watching in aggregate.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "targets": [
        { "refId": "A", "expr": "sum by (service, rule) (rate(arcadia_business_rule_rejections_total[5m]))", "legendFormat": "{{service}} {{rule}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Dead-lettered events",
      "description": "Each one is a business operation that did not happen. Should stay at zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "targets": [
        { "refId": "A", "expr": "sum by (service, topic) (increase(arcadia_events_dead_lettered_total[10m]))", "legendFormat": "{{service}} {{topic}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    }
  ]
}
