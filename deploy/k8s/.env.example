# Secrets for the arcadia namespace on the k8s cluster.
#
#   cp .env.example .env
#   # fill in real values (or run: python3 gen-secrets.py >> .env)
#   kubectl create secret generic arcadia-secrets -n arcadia --from-env-file=.env
#
# Mirrors infra/deploy/compose/.env.example's secret set, minus ports and image
# tags (those live in the manifests, not a shared secret).

POSTGRES_USER=arcadia
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

# A resolvable-looking domain, not `.local`. RFC 6762 reserves `.local` for
# mDNS, and the auth service's email validator refuses it — which meant the
# seeded Super-Admin existed in the database and could never log in, so nobody
# could approve a registration, grant a role or publish a game.
SUPER_ADMIN_EMAIL=admin@arcadia.example
SUPER_ADMIN_PASSWORD=change-me

GIFT_CARD_PEPPER=change-me
GATEWAY_CALLBACK_SECRET=change-me
MEDIA_DOWNLOAD_SECRET=change-me

MINIO_ROOT_USER=arcadia-root
MINIO_ROOT_PASSWORD=change-me
MEDIA_S3_BUCKET=arcadia-media
MEDIA_S3_ACCESS_KEY=arcadia-media-service
MEDIA_S3_SECRET_KEY=change-me

PLATFORM_USER_ID=00000000-0000-4000-8000-000000000001
WALLET_CURRENCY=IRR

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Recommendation's two third-party backends. Both are off in 25-recommendation.yaml
# (EMBEDDING_BACKEND=hashing, EXPLANATION_BACKEND=none), so these stay empty until one
# is switched on there — the manifest reads them as optional keys and the pod starts
# without them. The endpoint is the full path including the pipeline, POSTed verbatim:
#   https://router.huggingface.co/hf-inference/models/intfloat/multilingual-e5-large/pipeline/feature-extraction
# The prefix belongs to that model — "query: " for the e5 family, empty for bge-m3 and
# all-MiniLM — and EXPLANATION_BASE_URL is https://api.llm7.io/v1 for the model the
# manifest names. The keys are an hf_ token and a long opaque llm7.io one.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_PREFIX=
EXPLANATION_BASE_URL=
EXPLANATION_API_KEY=
